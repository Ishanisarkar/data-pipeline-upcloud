WITH rates AS (
    SELECT * FROM (VALUES
        ('USD', 0.93),
        ('EUR', 1.0),
        ('GBP', 1.12),
        ('JPY', 0.0062)
    ) AS t(currency, rate_to_eur)
),

base AS (
    SELECT
        DATE_TRUNC('day', b.timestamp) AS date,
        b.user_id,
